        <button class="month-btn" (click)="changeMonth(-1)">‹</button>
        <span class="month-label">{{ monthLabel() }}</span>
        <button class="month-btn" (click)="changeMonth(1)">›</button>
    </div>

    <!-- overall summary -->
    <div class="totals-card">
        <div class="total">
            <span class="total-label">Spent</span>
            <span class="total-value spent">${{ totalSpent() | number:'1.0-0' }}</span>
        </div>
        <div class="total">
            <span class="total-label">Budgeted</span>
            <span class="total-value">${{ totalBudget() | number:'1.0-0' }}</span>
        </div>
        <div class="total">
            <span class="total-label">Remaining</span>
            <span class="total-value"
                  [class.spent]="totalBudget() - totalSpent() < 0"
                  [class.remaining]="totalBudget() - totalSpent() >= 0">
                ${{ totalBudget() - totalSpent() | number:'1.0-0' }}
            </span>
        </div>

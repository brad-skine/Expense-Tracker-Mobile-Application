    cat_groceries       INT;
    cat_utilities       INT;
    cat_transport       INT;
    cat_eating_out      INT;
    cat_entertainment   INT;
    cat_sport           INT;
    cat_subscriptions   INT;
    cat_shopping        INT;
    cat_drinks          INT;
    cat_income          INT;
    cat_fees            INT;
